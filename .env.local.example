# AI Provider (openai | gemini | ollama)
AI_PROVIDER=openai

# Groq (free, fast — recommended)
OPENAI_API_KEY=your_groq_api_key_here
OPENAI_MODEL=llama-3.1-8b-instant
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (paid)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (free tier)
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# Ollama (local)
# AI_PROVIDER=ollama
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama2

# Turso Database
TURSO_DATABASE_URL=your_turso_database_url_here
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Paystack billing (https://dashboard.paystack.com/#/settings/developers)
# Secret key — server-side only, never expose to the client
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Pro price in kobo (100 kobo = 1 unit). Example: 1500000 = 15,000.00/month
PAYSTACK_PRO_AMOUNT_KOBO=1500000
# Price label shown in the UI
PAYSTACK_PRICE_LABEL=₦15,000
# Optional: create a monthly Plan in Paystack and put its code here to enable
# automatic recurring billing (recommended). Without it, each payment is one-off
# and Pro is granted for 32 days.
# PAYSTACK_PLAN_CODE=PLN_xxxxxxxxxxxxxxxx
